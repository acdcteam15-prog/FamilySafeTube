<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app updates: hand the downloaded update to Android's installer, and tell the parent a new build is out. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only used when the parent records their own voice for a quiz card (asked at that moment). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lets the parent exempt the app from battery optimisation so background sync is not killed
         mid-download (Samsung/Doze). Sync progress is shown in-app, so no notification permission. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- allowBackup is off: the app stores the (hashed) parental PIN and limits in SharedPreferences,
         and the content is re-downloaded by sync anyway. HTTPS only: Drive and YouTube both use it. -->
    <application
        android:name=".FamilySafeTubeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FamilySafeTube"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OfflinePlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name=".ImagePlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <!-- Android's answer to an install session (asks the user to confirm, reports failures). -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Lets the camera app write a photo for a "family card" into a private cache folder. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MatchActivity"
            android:exported="false"
            android:theme="@style/Theme.FamilySafeTube" />

        <activity
            android:name=".QuizActivity"
            android:exported="false"
            android:theme="@style/Theme.FamilySafeTube" />

        <activity
            android:name=".YoutubePlayerActivity"
            android:exported="false" />

    </application>

</manifest>
