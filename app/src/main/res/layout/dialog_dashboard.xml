<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1A1A1A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📉 Activity Dashboard"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvFavoriteCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Favorite: Loading..."
        android:textColor="#BBBBBB"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvStorageUsage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Storage: Loading..."
        android:textColor="#BBBBBB"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvLockAttempts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lock Attempts: Loading..."
        android:textColor="#FF5252"
        android:textSize="16sp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time per Category (Minutes):"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvCategoryBreakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="..."
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnCloseDashboard"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="CLOSE"
        android:backgroundTint="#424242"
        android:textColor="#FFFFFF" />

</LinearLayout>
