<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#222222">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ Session Settings"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Daily time limit (minutes):"
        android:textColor="#BBBBBB"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etTimeLimit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#333333"
        android:textColor="#FFFFFF"
        android:padding="10dp"
        android:inputType="number"
        android:hint="30"
        android:textColorHint="#666666" />

    <CheckBox
        android:id="@+id/cbVoiceOver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Image Voice-Over"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        android:checked="true" />

    <CheckBox
        android:id="@+id/cbWifiOnly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sync over Wi-Fi only"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp"
        android:checked="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bedtime Schedule (HH:mm)"
        android:textColor="#BBBBBB"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/etBedtimeStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="20:00"
            android:textColor="#FFFFFF"
            android:inputType="text" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" to "
            android:textColor="#FFFFFF" />
        <EditText
            android:id="@+id/etBedtimeEnd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="07:00"
            android:textColor="#FFFFFF"
            android:inputType="text" />
    </LinearLayout>

    <Button
        android:id="@+id/btnShowDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📈 View Activity Dashboard"
        android:backgroundTint="#2196F3"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnClearStorage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clear Offline Storage"
        android:backgroundTint="#D32F2F"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="SAVE CONFIG"
        android:backgroundTint="#00796B"
        android:textColor="#FFFFFF"
        android:layout_marginTop="24dp"
        android:textStyle="bold"/>

</LinearLayout>
